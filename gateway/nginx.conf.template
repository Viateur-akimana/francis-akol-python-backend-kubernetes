events {
    worker_connections 1024;
}

http {
    # Resolve DNS at runtime using public DNS servers
    resolver 8.8.8.8 1.1.1.1 valid=30s ipv6=off;

    server {
        listen 80;
        server_name _;

        # Health check endpoint
        location /health {
            return 200 '{"status": "healthy", "gateway": "nginx"}';
            add_header Content-Type application/json;
        }

        # User Service Routes
        location /api/v1/users {
            set $user_service "${USER_SERVICE_URL}";
            proxy_pass $user_service/api/v1/users;
            proxy_ssl_server_name on;
            proxy_set_header Host user-service-production-21db.up.railway.app;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/auth {
            set $user_service "${USER_SERVICE_URL}";
            proxy_pass $user_service/api/v1/auth;
            proxy_ssl_server_name on;
            proxy_set_header Host user-service-production-21db.up.railway.app;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Course Service Routes
        location /api/v1/courses {
            set $course_service "${COURSE_SERVICE_URL}";
            proxy_pass $course_service/api/v1/courses;
            proxy_ssl_server_name on;
            proxy_set_header Host course-service-production-720c.up.railway.app;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Enrollment Service Routes
        location /api/v1/enrollments {
            set $enrollment_service "${ENROLLMENT_SERVICE_URL}";
            proxy_pass $enrollment_service/api/v1/enrollments;
            proxy_ssl_server_name on;
            proxy_set_header Host enrollment-service-production-5561.up.railway.app;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Payment Service Routes
        location /api/v1/payments {
            set $payment_service "${PAYMENT_SERVICE_URL}";
            proxy_pass $payment_service/api/v1/payments;
            proxy_ssl_server_name on;
            proxy_set_header Host payment-service-production-ec55.up.railway.app;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Stripe Webhook
        location /api/v1/webhooks/stripe {
            set $payment_service "${PAYMENT_SERVICE_URL}";
            proxy_pass $payment_service/api/v1/webhooks/stripe;
            proxy_ssl_server_name on;
            proxy_set_header Host payment-service-production-ec55.up.railway.app;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
        }

        # Docs redirects - point to each service's actual Swagger UI
        location = /docs/users {
            return 302 ${USER_SERVICE_URL}/docs;
        }
        location = /docs/courses {
            return 302 ${COURSE_SERVICE_URL}/docs;
        }
        location = /docs/enrollments {
            return 302 ${ENROLLMENT_SERVICE_URL}/docs;
        }
        location = /docs/payments {
            return 302 ${PAYMENT_SERVICE_URL}/docs;
        }

        # Root - API info with documentation links
        location / {
            return 200 '{
                "name": "MLH Fellowship API Gateway",
                "version": "1.0.0",
                "endpoints": {
                    "users": "/api/v1/users",
                    "auth": "/api/v1/auth",
                    "courses": "/api/v1/courses",
                    "enrollments": "/api/v1/enrollments",
                    "payments": "/api/v1/payments"
                },
                "documentation": {
                    "users": "https://user-service-production-21db.up.railway.app/docs",
                    "courses": "https://course-service-production-720c.up.railway.app/docs",
                    "enrollments": "https://enrollment-service-production-5561.up.railway.app/docs",
                    "payments": "https://payment-service-production-ec55.up.railway.app/docs"
                },
                "health": "/health"
            }';
            add_header Content-Type application/json;
        }
    }
}
