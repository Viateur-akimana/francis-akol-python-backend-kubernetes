events {
    worker_connections 1024;
}

http {
    # Resolve DNS at runtime using public DNS servers
    resolver 8.8.8.8 1.1.1.1 valid=30s ipv6=off;

    server {
        listen 80;
        server_name _;

        # Health check endpoint
        location /health {
            return 200 '{"status": "healthy", "gateway": "nginx"}';
            add_header Content-Type application/json;
        }

        # User Service Routes
        location /api/v1/users {
            set $user_service "${USER_SERVICE_URL}";
            proxy_pass $user_service/api/v1/users;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/auth {
            set $user_service "${USER_SERVICE_URL}";
            proxy_pass $user_service/api/v1/auth;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Course Service Routes
        location /api/v1/courses {
            set $course_service "${COURSE_SERVICE_URL}";
            proxy_pass $course_service/api/v1/courses;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Enrollment Service Routes
        location /api/v1/enrollments {
            set $enrollment_service "${ENROLLMENT_SERVICE_URL}";
            proxy_pass $enrollment_service/api/v1/enrollments;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Payment Service Routes
        location /api/v1/payments {
            set $payment_service "${PAYMENT_SERVICE_URL}";
            proxy_pass $payment_service/api/v1/payments;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Stripe Webhook
        location /api/v1/webhooks/stripe {
            set $payment_service "${PAYMENT_SERVICE_URL}";
            proxy_pass $payment_service/api/v1/webhooks/stripe;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
        }

        # Docs routes for each service
        location /docs/users {
            set $user_service "${USER_SERVICE_URL}";
            proxy_pass $user_service/docs;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /docs/courses {
            set $course_service "${COURSE_SERVICE_URL}";
            proxy_pass $course_service/docs;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /docs/enrollments {
            set $enrollment_service "${ENROLLMENT_SERVICE_URL}";
            proxy_pass $enrollment_service/docs;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /docs/payments {
            set $payment_service "${PAYMENT_SERVICE_URL}";
            proxy_pass $payment_service/docs;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # Root - API info
        location / {
            return 200 '{
                "name": "MLH Fellowship API Gateway",
                "version": "1.0.0",
                "endpoints": {
                    "users": "/api/v1/users",
                    "auth": "/api/v1/auth",
                    "courses": "/api/v1/courses",
                    "enrollments": "/api/v1/enrollments",
                    "payments": "/api/v1/payments"
                },
                "docs": {
                    "users": "/docs/users",
                    "courses": "/docs/courses",
                    "enrollments": "/docs/enrollments",
                    "payments": "/docs/payments"
                },
                "health": "/health"
            }';
            add_header Content-Type application/json;
        }
    }
}
