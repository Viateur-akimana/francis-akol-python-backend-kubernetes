# ============================================
# Modular Learning Hub - Environment Variables
# ============================================
# Copy this file to .env and update with your values

# ============================================
# Application Environment
# ============================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mlh_user
POSTGRES_PASSWORD=mlh_secure_password_change_me
POSTGRES_DB=mlh_db

# Service-specific PostgreSQL databases
USER_DB_NAME=user_db
COURSE_DB_NAME=course_db
ENROLLMENT_DB_NAME=enrollment_db
PAYMENT_DB_NAME=payment_db

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=mlh_mongo_user
MONGODB_PASSWORD=mlh_mongo_password_change_me
MONGODB_DB=mlh_content_db
MONGODB_AUTH_SOURCE=admin

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=mlh_redis_password_change_me
REDIS_DB=0
REDIS_CACHE_TTL=600  # Cache TTL in seconds (10 minutes)
REDIS_SESSION_TTL=86400  # Session TTL in seconds (24 hours)

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://:mlh_redis_password_change_me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:mlh_redis_password_change_me@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false  # Set to true for synchronous testing

# ============================================
# JWT & Security Configuration
# ============================================
# IMPORTANT: Generate secure random keys for production!
# Use: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# ============================================
# Service URLs (Internal Communication)
# ============================================
USER_SERVICE_URL=http://user-service:8001
COURSE_SERVICE_URL=http://course-service:8002
ENROLLMENT_SERVICE_URL=http://enrollment-service:8003
PAYMENT_SERVICE_URL=http://payment-service:8004

# Inter-service API key (for service-to-service authentication)
INTER_SERVICE_API_KEY=service-api-key-change-this-in-production

# ============================================
# API Configuration
# ============================================
API_V1_PREFIX=/api/v1
PROJECT_NAME=Modular Learning Hub
VERSION=1.0.0
DOCS_URL=/docs
REDOC_URL=/redoc

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Email Configuration (for Celery tasks)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@mlh.example.com
SMTP_FROM_NAME=Modular Learning Hub

# ============================================
# Monitoring & Observability
# ============================================
# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=true

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_me

# Sentry (Optional - for error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Payment Gateway (Mock)
# ============================================
PAYMENT_GATEWAY_URL=https://api.mock-payment-gateway.com
PAYMENT_GATEWAY_API_KEY=mock-payment-key
PAYMENT_GATEWAY_SECRET=mock-payment-secret
PAYMENT_CURRENCY=USD

# ============================================
# File Storage (Optional - MinIO for S3-compatible storage)
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET_NAME=mlh-uploads
MINIO_SECURE=false  # Set to true in production with HTTPS

# ============================================
# Testing Configuration
# ============================================
TEST_DATABASE_URL=postgresql://mlh_user:mlh_secure_password_change_me@localhost:5432/mlh_test_db
TEST_MONGODB_URL=mongodb://mlh_mongo_user:mlh_mongo_password_change_me@localhost:27017/mlh_test_content
TEST_REDIS_URL=redis://:mlh_redis_password_change_me@localhost:6379/15

# ============================================
# OpenAI Configuration (Optional - Stretch Goal)
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# ============================================
# Docker Configuration
# ============================================
COMPOSE_PROJECT_NAME=mlh
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================
# Development Tools
# ============================================
# Auto-reload on code changes
RELOAD=true

# Show SQL queries in logs (development only)
SQL_ECHO=false

# Pretty print JSON responses
JSON_INDENT=2
